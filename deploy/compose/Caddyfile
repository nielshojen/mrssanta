# Mirrors the path routing of the Kubernetes ingress in deploy/modules/app/ingress.tf
:80 {
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}

	handle /santa/preflight* {
		reverse_proxy preflight:8080
	}

	handle /santa/eventupload* {
		reverse_proxy eventupload:8080
	}

	handle /santa/ruledownload* {
		reverse_proxy ruledownload:8080
	}

	handle /santa/postflight* {
		reverse_proxy postflight:8080
	}

	handle /santa/xsrf* {
		reverse_proxy xsrf:8080
	}

	handle /metrics* {
		reverse_proxy metrics:8080
	}

	handle /admin* {
		reverse_proxy admin:8080
	}

	@web path /santa/blockables* /santa/moreinfo* /santa/token* /santa/login* /santa/logout* /santa/static/*
	handle @web {
		reverse_proxy web:8080
	}

	handle {
		respond 404
	}
}
